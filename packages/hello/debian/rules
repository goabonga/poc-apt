#!/usr/bin/make -f

# Launchpad's builders have no network access: scripts/build-source.sh runs
# `go mod vendor` before assembling the orig tarball, so -mod=vendor is the
# only mode that can possibly succeed here.
export CGO_ENABLED=0
export GOFLAGS=-mod=vendor

%:
	dh $@

override_dh_auto_build:
	go build -trimpath -ldflags='-s -w' -o poc-hello ./cmd/hello

override_dh_auto_install:
	install -Dm755 poc-hello debian/poc-hello/usr/bin/poc-hello
